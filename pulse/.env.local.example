# Supabase — required before running the app
# New projects (post-Nov 2025): use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (sb_publishable_...)
# Legacy projects: use NEXT_PUBLIC_SUPABASE_ANON_KEY (eyJ... JWT format)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Phase 3: Transcript Pipeline
YOUTUBE_API_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=pulse-transcripts
# SUPABASE_SERVICE_ROLE_KEY may already exist from Phase 2 — leave the existing entry; add only if missing
SUPABASE_SERVICE_ROLE_KEY=
